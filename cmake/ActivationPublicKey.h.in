#pragma once

// Generated by CMake from cmake/activation-public-key.txt.
//
// The public half of the activation keypair, in juce::RSAKey's "exponent,modulus" hex
// form. It verifies activation tokens; it cannot create them.
//
// This one is meant to be in the binary and in the repository. The half that matters --
// the private key that signs tokens -- lives only in Supabase's secret store as
// ACTIVATION_PRIVATE_KEY, and is never compiled in.
//
// That split is the point of online activation. The older licence secret is compiled in
// (see LicenceSecret.h), which means extracting it yields a working key generator. This
// one yields nothing.
//
// Replacing the pair invalidates every activation already issued: every customer would
// have to activate again.

#define LOSTDUCK_ACTIVATION_PUBLIC_KEY "@LOSTDUCK_ACTIVATION_PUBLIC_KEY@"
